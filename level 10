# FLASK WEB SERVER
# ===============================
class RescueServer:
    def __init__(self):
        self.app = Flask(__name__)
        self.detector = None
        self.frame = None
        self.fps = 0
        self.global_url = None
        self.ngrok = None
        self.local_ip = self.get_local_ip()
        self.setup_routes()
        
    def get_local_ip(self):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("8.8.8.8", 80))
            ip = s.getsockname()[0]
            s.close()
            return ip
        except:
            return "127.0.0.1"
    
    def setup_routes(self):
        @self.app.route('/')
        def index():
            return render_template_string(
                MODE_SELECTION_HTML,
                modes=MODES,
                ip=self.local_ip,
                port=CONFIG["web_port"]
            )
        
        @self.app.route('/start/<mode>')
        def start_mode(mode):
            if mode in MODES:
                self.detector = ModeDetector(mode)
                return render_template_string(
                    DETECTION_HTML,
                    mode_name=self.detector.mode['name'],
                    mode_color='#'.join(str(x) for x in self.detector.mode['color']),
                    stats=self.detector.stats,
                    recent_detections=self.detector.capture_manager.recent_detections[:10],
                    captured_count=len(self.detector.capture_manager.captured_images),
                    fps="0.0",
                    local_ip=self.local_ip,
                    global_url=self.global_url
                )
            return "Invalid mode", 404
        
        @self.app.route('/detection')
        def detection():
            if self.detector:
                return render_template_string(
                    DETECTION_HTML,
                    mode_name=self.detector.mode['name'],
                    mode_color='#'.join(str(x) for x in self.detector.mode['color']),
                    stats=self.detector.stats,
                    recent_detections=self.detector.capture_manager.recent_detections[:10],
                    captured_count=len(self.detector.capture_manager.captured_images),
                    fps=f"{self.fps:.1f}",
                    local_ip=self.local_ip,
                    global_url=self.global_url
                )
            return redirect('/')
        
        @self.app.route('/video_feed')
        def video_feed():
            return Response(self.generate_frames(),
                          mimetype='multipart/x-mixed-replace; boundary=frame')
        
        @self.app.route('/stats')
        def get_stats():
            if self.detector:
                return jsonify(self.detector.stats)
            return jsonify({})
        
        @self.app.route('/gallery')
        def gallery():
            if self.detector:
                images = self.detector.capture_manager.captured_images[-50:]  # Last 50
                return render_template_string(
                    GALLERY_HTML,
                    images=images,
                    count=len(images)
                )
            return "No images", 404
        
        @self.app.route('/image/<filename>')
        def get_image(filename):
            filepath = Path("captured_images") / filename
            if filepath.exists():
                return send_file(str(filepath), mimetype='image/jpeg')
            return "Image not found", 404
        
        @self.app.route('/download/<filename>')
        def download_image(filename):
            filepath = Path("captured_images") / filename
            if filepath.exists():
                return send_file(str(filepath), as_attachment=True)
            return "Image not found", 404
    
    def generate_frames(self):
        while True:
            if self.frame is not None:
                try:
                    _, buffer = cv2.imencode('.jpg', self.frame, [cv2.IMWRITE_JPEG_QUALITY, 80])
                    yield (b'--frame\r\n'
                          b'Content-Type: image/jpeg\r\n\r\n' + buffer.tobytes() + b'\r\n')
                except:
                    pass
            time.sleep(0.03)
    
    def update_frame(self, frame, fps):
        self.frame = frame
        self.fps = fps
    
    def run(self):
        threading.Thread(target=self.app.run, 
                        kwargs={'host': CONFIG["web_host"], 
                               'port': CONFIG["web_port"], 
                               'debug': False, 
                               'threaded': True,
                               'use_reloader': False},
                        daemon=True).start()

# ===============================
# MAIN FUNCTION
# ===============================
def main():
    print("=" * 80)
    print("🚁 MULTI-MODE DISASTER RESCUE SYSTEM")
    print("=" * 80)
    
    # Create necessary folders
    Path("captured_images").mkdir(exist_ok=True)
    Path("models").mkdir(exist_ok=True)
    
    # Start server
    server = RescueServer()
    server.run()
    
    # Setup global access
    if CONFIG["ngrok_auth_token"] != "YOUR_TOKEN_HERE":
        ngrok = NgrokManager()
        server.global_url = ngrok.start_tunnel(CONFIG["web_port"])
        server.ngrok = ngrok
    
    # Screen capture
    sct = mss()
    screen = CONFIG["screen_region"]
    
    print("\n" + "=" * 80)
    print("📱 ACCESS INFORMATION")
    print("=" * 80)
    print(f"📍 Local access: http://{server.local_ip}:{CONFIG['web_port']}")
    if server.global_url:
        print(f"🌍 Global access: {server.global_url}")
    print("=" * 80)
    print("\n✅ Server running. Open browser to select mode.")
    print("   Press Ctrl+C to stop\n")
    
    # Detection loop (runs after mode selected)
    last_capture_time = 0
    capture_cooldown = 2  # seconds between captures
    
    try:
        while True:
            if server.detector:
                frame_start = time.time()
                
                # Capture screen
                img = sct.grab(screen)
                frame = np.array(img)
                frame = cv2.cvtColor(frame, cv2.COLOR_BGRA2BGR)
                
                # Detect
                detections, zoom_target = server.detector.detect(frame)
                
                # Draw on frame
                display = frame.copy()
                
                for det in detections:
                    x1, y1, x2, y2 = det["bbox"]
                    cv2.rectangle(display, (x1, y1), (x2, y2), 
                                 server.detector.mode['color'], 2)
                    cv2.putText(display, f"{det['label']} {det['conf']:.2f}", 
                              (x1, y1-5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, 
                              server.detector.mode['color'], 1)
                
                # Auto-capture on detection
                current_time = time.time()
                if zoom_target and (current_time - last_capture_time) > capture_cooldown:
                    filename = server.detector.capture_manager.capture(
                        frame, zoom_target, 
                        server.detector.mode['name'],
                        f"{server.local_ip}:{CONFIG['web_port']}"
                    )
                    print(f"📸 Captured #{server.detector.capture_manager.serial_counter-1:04d}")
                    last_capture_time = current_time
                
                # Calculate FPS
                fps = 1.0 / (time.time() - frame_start)
                server.update_frame(display, fps)
            
            time.sleep(0.01)
    
    except KeyboardInterrupt:
        print("\n🛑 Shutting down...")
        if server.ngrok:
            server.ngrok.stop_tunnel()
        cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
