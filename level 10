# IMAGE CAPTURE MANAGER
# ===============================
class ImageCaptureManager:
    def __init__(self):
        self.capture_dir = Path("captured_images")
        self.capture_dir.mkdir(exist_ok=True)
        self.serial_counter = 1
        self.recent_detections = []
        self.captured_images = []
        
    def capture(self, frame, detection_info, mode_name, location):
        """Capture image with zoom and save"""
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        
        # Zoom on detection
        if detection_info:
            x1, y1, x2, y2 = detection_info['bbox']
            # Add padding
            h, w = frame.shape[:2]
            pad = 50
            x1 = max(0, x1 - pad)
            y1 = max(0, y1 - pad)
            x2 = min(w, x2 + pad)
            y2 = min(h, y2 + pad)
            
            # Zoom
            zoomed = frame[y1:y2, x1:x2]
            zoomed = cv2.resize(zoomed, (w, h))
            capture_frame = zoomed
        else:
            capture_frame = frame
        
        # Save image
        filename = f"detection_{timestamp}_S{self.serial_counter:04d}.jpg"
        filepath = self.capture_dir / filename
        cv2.imwrite(str(filepath), capture_frame)
        
        # Store info
        image_info = {
            'filename': filename,
            'serial': f"S{self.serial_counter:04d}",
            'time': datetime.now().strftime("%H:%M:%S"),
            'date': datetime.now().strftime("%Y-%m-%d"),
            'mode': mode_name,
            'location': location,
            'detection': detection_info
        }
        
        self.captured_images.append(image_info)
        
        # Add to recent detections
        if detection_info:
            self.recent_detections.insert(0, {
                'serial': f"S{self.serial_counter:04d}",
                'label': f"{detection_info['label']}",
                'conf': f"{detection_info['conf']*100:.1f}",
                'time': datetime.now().strftime("%H:%M:%S")
            })
            
            # Keep last 50 detections
            if len(self.recent_detections) > 50:
                self.recent_detections.pop()
        
        self.serial_counter += 1
        return filename
    
    def get_stats(self):
        return {
            'serial': f"S{self.serial_counter-1:04d}",
            'total_captured': len(self.captured_images)
        }

# ===============================
# NGROK MANAGER
# ===============================
class NgrokManager:
    def __init__(self):
        self.ngrok_path = Path("ngrok.exe" if platform.system() == "Windows" else "ngrok")
        self.public_url = None
        self.process = None
        
    def download_ngrok(self):
        if self.ngrok_path.exists():
            return True
            
        print("\n📥 Downloading Ngrok...")
        system = platform.system()
        if system == "Windows":
            url = "https://bin.equinox.io/c/bNyj1mQVY4c/ngrok-v3-stable-windows-amd64.zip"
        elif system == "Linux":
            url = "https://bin.equinox.io/c/bNyj1mQVY4c/ngrok-v3-stable-linux-amd64.tgz"
        elif system == "Darwin":
            url = "https://bin.equinox.io/c/bNyj1mQVY4c/ngrok-v3-stable-darwin-amd64.zip"
        else:
            return False
        
        try:
            response = requests.get(url, stream=True)
            zip_path = Path("ngrok.zip")
            with open(zip_path, 'wb') as f:
                for chunk in response.iter_content(chunk_size=8192):
                    f.write(chunk)
            
            if zip_path.suffix == '.zip':
                with zipfile.ZipFile(zip_path, 'r') as zip_ref:
                    zip_ref.extractall(".")
            else:
                import tarfile
                with tarfile.open(zip_path, 'r:gz') as tar_ref:
                    tar_ref.extractall(".")
            
            zip_path.unlink()
            if system != "Windows":
                os.chmod(self.ngrok_path, 0o755)
            
            print("✅ Ngrok downloaded")
            return True
        except:
            return False
    
    def start_tunnel(self, port):
        if not self.ngrok_path.exists():
            if not self.download_ngrok():
                return None
        
        try:
            # Add auth token
            if CONFIG["ngrok_auth_token"] and CONFIG["ngrok_auth_token"] != "YOUR_TOKEN_HERE":
                subprocess.run([str(self.ngrok_path), "config", "add-authtoken", 
                              CONFIG["ngrok_auth_token"]], capture_output=True)
            
            # Start ngrok
            self.process = subprocess.Popen(
                [str(self.ngrok_path), "http", str(port), "--log=stdout"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            
            time.sleep(3)
            
            # Get URL
            try:
                response = requests.get("http://localhost:4040/api/tunnels")
                data = response.json()
                for tunnel in data['tunnels']:
                    if tunnel['proto'] == 'https':
                        self.public_url = tunnel['public_url']
                        break
                
                return self.public_url
            except:
                return None
                
        except:
            return None
    
    def stop_tunnel(self):
        if self.process:
            self.process.terminate()

