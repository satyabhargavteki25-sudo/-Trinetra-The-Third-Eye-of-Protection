def get_local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except:
        return "127.0.0.1"

def check_python_version():
    version = sys.version_info
    print(f"   Python {version.major}.{version.minor}.{version.micro}")
    return version.major == 3 and version.minor >= 8

def install_requirements():
    print("\n📦 Installing required libraries...")
    requirements = [
        "ultralytics",
        "opencv-python",
        "numpy",
        "mss",
        "flask",
        "pillow",
        "requests"
    ]
    
    for package in requirements:
        print(f"   Installing {package}...")
        try:
            subprocess.check_call([sys.executable, "-m", "pip", "install", "--quiet", package])
            print(f"   ✅ {package} installed")
        except:
            print(f"   ⚠ Failed to install {package}")

# ===============================
# MAIN FUNCTION
# ===============================
def main():
    print("=" * 70)
    print("👥 ENHANCED HUMAN DETECTION WITH AGE/GENDER/ACTIVITY")
    print("=" * 70)
    
    # Setup
    print("\n🛠️  Running setup...")
    if not check_python_version():
        print("⚠ Python 3.8+ recommended")
    
    install_requirements()
    
    # Download pretrained models
    if CONFIG["auto_download"]:
        download_pretrained_models()
    
    # Initialize detector
    detector = EnhancedDetector()
    
    # Start web server
    server = WebServer(detector)
    server.run()
    
    # Screen capture
    sct = mss()
    screen = CONFIG["screen_region"]
    
    # Local window
    cv2.namedWindow("Enhanced Detection", cv2.WINDOW_NORMAL)
    cv2.resizeWindow("Enhanced Detection", 800, 600)
    
    # Connection info
    local_ip = get_local_ip()
    print("\n" + "=" * 70)
    print("🌐 WEB INTERFACE ACCESS")
    print("=" * 70)
    print(f"📱 Local: http://localhost:{CONFIG['web_port']}")
    print(f"📱 Network: http://{local_ip}:{CONFIG['web_port']}")
    print("=" * 70)
    print("\n✅ RUNNING - Press ESC to exit")
    
    # Performance tracking
    start_time = time.time()
    frame_count = 0
    
    try:
        while True:
            frame_start = time.time()
            
            # Capture
            img = sct.grab(screen)
            frame = np.array(img)
            frame = cv2.cvtColor(frame, cv2.COLOR_BGRA2BGR)
            
            # Detect
            detections = detector.detect(frame)
            
            # Draw on frame
            display = frame.copy()
            for det in detections:
                x1, y1, x2, y2 = det["bbox"]
                color = det["color"]
                
                # Draw bounding box
                cv2.rectangle(display, (x1, y1), (x2, y2), color, 2)
                
                # Draw info label
                label = f"{det['gender']} {det['age_category']} {det['activity']}"
                cv2.putText(display, label, (x1, y1-5),
                           cv2.FONT_HERSHEY_SIMPLEX, 0.4, color, 1)
            
            # FPS calculation
            frame_count += 1
            elapsed = time.time() - start_time
            fps = frame_count / elapsed if elapsed > 0 else 0
            proc_time = (time.time() - frame_start) * 1000
            
            # Update server
            server.update_frame(display, fps, proc_time)
            
            # Show local window
            cv2.imshow("Enhanced Detection", display)
            
            # Exit on ESC
            if cv2.waitKey(1) & 0xFF == 27:
                break
                
    except KeyboardInterrupt:
        print("\n\n🛑 Stopped by user")
    finally:
        cv2.destroyAllWindows()
        print("\n✅ Done!")

if __name__ == "__main__":
    main()
