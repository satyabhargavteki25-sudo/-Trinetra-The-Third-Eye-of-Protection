# ===============================
# ENHANCED DETECTOR CLASS
# ===============================
class EnhancedDetector:
    def __init__(self):
        print("\n📦 Loading models...")
        
        # Main YOLO for human detection
        self.model = YOLO("yolov8n.pt")
        
        # Age and Gender models (OpenCV DNN)
        self.age_net = cv2.dnn.readNetFromCaffe(
            "models/age_deploy.prototxt",
            "models/age_net.caffemodel"
        )
        self.gender_net = cv2.dnn.readNetFromCaffe(
            "models/gender_deploy.prototxt",
            "models/gender_net.caffemodel"
        )
        
        # Age categories
        self.age_list = ['(0-2)', '(4-6)', '(8-12)', '(15-20)', 
                        '(25-32)', '(38-43)', '(48-53)', '(60-100)']
        
        # Gender categories
        self.gender_list = ['Male', 'Female']
        
        # Activity classes (simplified for demo)
        self.activities = ['standing', 'walking', 'running', 'sitting', 
                          'lying', 'waving', 'pointing', 'carrying']
        
        # Size categories with distance
        self.size_categories = {
            "tiny": {"range": (5, 20), "color": (0, 0, 255), "distance": "200m"},
            "small": {"range": (20, 40), "color": (0, 165, 255), "distance": "150m"},
            "medium": {"range": (40, 80), "color": (0, 255, 255), "distance": "100m"},
            "large": {"range": (80, 150), "color": (0, 255, 0), "distance": "50m"},
            "xlarge": {"range": (150, 2000), "color": (255, 0, 255), "distance": "<20m"}
        }
        
        # Statistics with new fields
        self.stats = {
            'total': 0,
            'tiny': 0, 'small': 0, 'medium': 0, 'large': 0, 'xlarge': 0,
            'boys': 0,
            'girls': 0,
            'men': 0,
            'women': 0,
            'infants': 0,
            'children': 0,
            'adults': 0,
            'elderly': 0,
            'activities': {}
        }
        
        self.last_detections = []
        self.avg_confidence = 0.0
        print("✅ Enhanced detector ready")
    
    def estimate_age_gender(self, face_roi):
        """Estimate age and gender from face region"""
        if face_roi.size == 0:
            return "Unknown", "Unknown", "Unknown"
        
        try:
            # Prepare blob for gender detection
            blob = cv2.dnn.blobFromImage(face_roi, 1.0, (227, 227),
                                        (78.4263377603, 87.7689143744, 114.895847746),
                                        swapRB=False)
            
            # Predict gender
            self.gender_net.setInput(blob)
            gender_preds = self.gender_net.forward()
            gender = self.gender_list[gender_preds[0].argmax()]
            
            # Predict age
            self.age_net.setInput(blob)
            age_preds = self.age_net.forward()
            age_range = self.age_list[age_preds[0].argmax()]
            
            # Convert age range to category
            age_num = int(age_range.strip('()').split('-')[0])
            if age_num < 4:
                age_category = "Infant"
            elif age_num < 12:
                age_category = "Child"
            elif age_num < 20:
                age_category = "Teen"
            elif age_num < 60:
                age_category = "Adult"
            else:
                age_category = "Elderly"
            
            return gender, age_range, age_category
            
        except:
            return "Unknown", "Unknown", "Unknown"
    
    def estimate_activity(self, prev_pos, curr_pos, bbox_size):
        """Estimate activity based on movement and position"""
        if prev_pos is None:
            return "standing"
        
        # Calculate movement
        dx = curr_pos[0] - prev_pos[0]
        dy = curr_pos[1] - prev_pos[1]
        movement = np.sqrt(dx**2 + dy**2)
        
        # Activity classification based on movement
        if movement < 2:
            return "standing"
        elif movement < 5:
            return "walking"
        elif movement < 10:
            return "jogging"
        else:
            return "running"
    
    def detect(self, frame):
        # Store previous positions for activity detection
        if not hasattr(self, 'prev_positions'):
            self.prev_positions = {}
        
        results = self.model(frame, conf=CONFIG["confidence"], verbose=False, classes=[0])
        
        # Reset stats
        for key in self.stats:
            if key != 'activities':
                self.stats[key] = 0
        self.stats['activities'] = {}
        
        detections = []
        total_conf = 0.0
        
        for r in results:
            for idx, box in enumerate(r.boxes):
                x1, y1, x2, y2 = map(int, box.xyxy[0])
                conf = float(box.conf[0])
                size = max(x2 - x1, y2 - y1)
                
                # Get size category
                cat, info = self.get_category(size)
                self.stats[cat] += 1
                
                # Extract face region for age/gender (upper part of bbox)
                face_roi = frame[y1:y1 + (y2-y1)//3, x1:x2]
                gender, age_range, age_cat = self.estimate_age_gender(face_roi)
                
                # Update age/gender stats
                if gender == "Male":
                    if age_cat == "Infant" or age_cat == "Child":
                        self.stats['boys'] += 1
                    else:
                        self.stats['men'] += 1
                elif gender == "Female":
                    if age_cat == "Infant" or age_cat == "Child":
                        self.stats['girls'] += 1
                    else:
                        self.stats['women'] += 1
                
                # Age category stats
                if age_cat == "Infant":
                    self.stats['infants'] += 1
                elif age_cat == "Child" or age_cat == "Teen":
                    self.stats['children'] += 1
                elif age_cat == "Adult":
                    self.stats['adults'] += 1
                elif age_cat == "Elderly":
                    self.stats['elderly'] += 1
                
                # Estimate activity
                center = ((x1 + x2)//2, (y1 + y2)//2)
                activity = self.estimate_activity(
                    self.prev_positions.get(idx, None),
                    center,
                    size
                )
                self.prev_positions[idx] = center
                
                # Update activity stats
                if activity in self.stats['activities']:
                    self.stats['activities'][activity] += 1
                else:
                    self.stats['activities'][activity] = 1
                
                total_conf += conf
                
                detections.append({
                    "bbox": (x1, y1, x2, y2),
                    "confidence": conf,
                    "size": size,
                    "category": cat,
                    "color": info["color"],
                    "center": center,
                    "distance": info["distance"],
                    "gender": gender,
                    "age_range": age_range,
                    "age_category": age_cat,
                    "activity": activity
                })
        
        self.stats['total'] = len(detections)
        self.last_detections = detections
        
        if len(detections) > 0:
            self.avg_confidence = total_conf / len(detections)
        else:
            self.avg_confidence = 0.0
        
        return detections
    
    def get_category(self, size):
        for cat, info in self.size_categories.items():
            if info["range"][0] <= size <= info["range"][1]:
                return cat, info
        return "large", self.size_categories["large"]
    
    def get_detection_summary(self):
        """Return list of detections for web display"""
        return [
            {
                "category": d["category"],
                "distance": d["distance"],
                "confidence": d["confidence"],
                "gender": d["gender"],
                "age": d["age_range"],
                "activity": d["activity"]
            }
            for d in self.last_detections
        ]

