# ===============================
# SINGLE MODEL MANAGER - FIXED!
# ===============================
class ModelManager:
    """Single model for ALL modes - prevents download conflicts"""
    
    _instance = None
    _model = None
    
    def __new__(cls):
        if cls._instance is None:
            cls._instance = super(ModelManager, cls).__new__(cls)
            cls._instance._load_model()
        return cls._instance
    
    def _load_model(self):
        """Load model once - shared across all modes"""
        model_path = Path("models/yolov8n.pt")
        model_path.parent.mkdir(exist_ok=True)
        
        # Download if not exists
        if not model_path.exists():
            print("\n📥 Downloading YOLOv8n model (6.2 MB)...")
            url = "https://github.com/ultralytics/assets/releases/download/v8.2.0/yolov8n.pt"
            
            try:
                response = requests.get(url, stream=True)
                total_size = int(response.headers.get('content-length', 0))
                
                with open(model_path, 'wb') as f:
                    downloaded = 0
                    for chunk in response.iter_content(chunk_size=8192):
                        if chunk:
                            f.write(chunk)
                            downloaded += len(chunk)
                            if total_size > 0:
                                percent = (downloaded / total_size) * 100
                                print(f"\r   Progress: {percent:.1f}%", end='')
                
                print("\n✅ Model downloaded")
            except Exception as e:
                print(f"❌ Download failed: {e}")
                return
        
        # Load model
        try:
            self._model = YOLO(str(model_path))
            print("✅ Model loaded successfully")
        except Exception as e:
            print(f"❌ Failed to load model: {e}")
    
    def get_model(self):
        return self._model

# ===============================
# MODE DETECTOR - USES SHARED MODEL
# ===============================
class ModeDetector:
    def __init__(self, mode_num):
        self.mode_num = mode_num
        self.mode = MODES[mode_num]
        self.recent_detections = []
        self.stats = {'total': 0}
        
        # Get shared model
        model_manager = ModelManager()
        self.model = model_manager.get_model()
        
        print(f"✅ {self.mode['name']} mode ready")
    
    def detect(self, frame):
        results = self.model(frame, conf=CONFIG["confidence"], verbose=False)
        
        detections = []
        
        for r in results:
            for box in r.boxes:
                cls_id = int(box.cls[0])
                conf = float(box.conf[0])
                
                # MODE-SPECIFIC FILTERING
                if cls_id in self.mode["classes"]:
                    x1, y1, x2, y2 = map(int, box.xyxy[0])
                    
                    # Get class name
                    label = self.mode["class_names"].get(cls_id, f"Class {cls_id}")
                    
                    detections.append({
                        "bbox": (x1, y1, x2, y2),
                        "label": label,
                        "conf": conf
                    })
                    
                    # Recent detections
                    self.recent_detections.insert(0, {
                        'label': label,
                        'conf': f"{conf*100:.1f}"
                    })
                    if len(self.recent_detections) > 10:
                        self.recent_detections.pop()
        
        self.stats['total'] = len(detections)
        return detections

# ===============================
# FLASK SERVER
# ===============================
class RescueServer:
    def __init__(self):
        self.app = Flask(__name__)
        self.detector = None
        self.frame = None
        self.fps = 0
        self.setup_routes()
    
    def setup_routes(self):
        @self.app.route('/')
        def index():
            return render_template_string(
                MODE_SELECTION_HTML,
                modes=MODES
            )
        
        @self.app.route('/start/<mode>')
        def start_mode(mode):
            if mode in MODES:
                self.detector = ModeDetector(mode)
                return render_template_string(
                    DETECTION_HTML,
                    mode_name=MODES[mode]['name'],
                    mode_color='#'.join(str(x) for x in MODES[mode]['color']),
                    stats={'total': 0},
                    recent_detections=[],
                    fps="0.0"
                )
            return "Invalid mode", 404
        
        @self.app.route('/video_feed')
        def video_feed():
            return Response(self.generate_frames(),
                          mimetype='multipart/x-mixed-replace; boundary=frame')
        
        @self.app.route('/stats')
        def get_stats():
            if self.detector:
                return jsonify(self.detector.stats)
            return jsonify({})
    
    def generate_frames(self):
        while True:
            if self.frame is not None:
                try:
                    _, buffer = cv2.imencode('.jpg', self.frame)
                    yield (b'--frame\r\n'
                          b'Content-Type: image/jpeg\r\n\r\n' + buffer.tobytes() + b'\r\n')
                except:
                    pass
            time.sleep(0.03)
    
    def update_frame(self, frame, fps):
        self.frame = frame
        self.fps = fps
    
    def run(self):
        threading.Thread(target=self.app.run, 
                        kwargs={'host': CONFIG["web_host"], 
                               'port': CONFIG["web_port"], 
                               'debug': False, 
                               'threaded': True,
                               'use_reloader': False},
                        daemon=True).start()

# ===============================
# MAIN
# ===============================
def main():
    print("=" * 80)
    print("🚁 MULTI-MODE RESCUE SYSTEM - ALL MODES FIXED")
    print("=" * 80)
    
    # Create folders
    Path("models").mkdir(exist_ok=True)
    
    # Pre-load model (so it's ready)
    print("\n📦 Initializing model...")
    ModelManager()
    
    # Start server
    server = RescueServer()
    server.run()
    
    # Screen capture
    sct = mss()
    screen = CONFIG["screen_region"]
    
    print("\n" + "=" * 80)
    print("📱 ACCESS")
    print("=" * 80)
    print("📍 http://localhost:5000")
    print("=" * 80)
    print("\n✅ All 8 modes ready! Press Ctrl+C to stop\n")
    
    try:
        while True:
            if server.detector:
                frame_start = time.time()
                
                # Capture
                img = sct.grab(screen)
                frame = np.array(img)
                frame = cv2.cvtColor(frame, cv2.COLOR_BGRA2BGR)
                
                # Detect
                detections = server.detector.detect(frame)
                
                # Draw
                display = frame.copy()
                for det in detections:
                    x1, y1, x2, y2 = det["bbox"]
                    color = MODES[server.detector.mode_num]["color"]
                    cv2.rectangle(display, (x1, y1), (x2, y2), color, 2)
                    cv2.putText(display, f"{det['label']}", (x1, y1-5),
                               cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 1)
                
                # FPS
                fps = 1.0 / (time.time() - frame_start)
                server.update_frame(display, fps)
                
                # Show status
                if len(detections) > 0:
                    print(f"\r⚡ {server.detector.mode['name']} | "
                          f"Detected: {len(detections)} | "
                          f"Latest: {detections[0]['label']}", end='')
            
            time.sleep(0.01)
    
    except KeyboardInterrupt:
        print("\n\n🛑 Shutting down...")
        cv2.destroyAllWindows()

